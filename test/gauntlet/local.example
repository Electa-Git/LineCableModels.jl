# Copy this file to local.jl and replace every path with the corresponding
# value on the PSCAD host. The last expression must be a RemoteConfig.

RemoteConfig(
    "pscad-host",
    raw"Z:\path\to\LineCableModels\test\gauntlet\benchmarks\.work",
    raw"C:\LineCableModelsGauntlet",
    raw"C:\Users\operator\.julia\juliaup\julia-1.12.7+0.x64.w64.mingw32\bin\julia.exe",
    raw"C:\Python311\python.exe";
    pscad_version = "5.1.0",
    transport = :ssh,
    timeout_seconds = 1800,
)

