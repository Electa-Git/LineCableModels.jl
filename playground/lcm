#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'

readonly LAUNCHER_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${LAUNCHER_PATH}")" && pwd)"
readonly JULIA_COMMAND="${LCM_JULIA:-julia}"

# Private two-computer demo lifecycle is an operator action, not a runtime API.
if [[ "${1:-}" == "demo" ]]; then
    shift
    exec bash "${SCRIPT_DIR}/deploy/demo/demo" "$@"
fi

die() {
    printf 'lcm: %s\n' "$*" >&2
    exit 1
}

command -v "${JULIA_COMMAND}" >/dev/null 2>&1 \
    || die "Julia executable not found: ${JULIA_COMMAND}"

if [[ "${1:-}" == "worker" ]]; then
    exec "${JULIA_COMMAND}" --startup-file=no --threads=auto \
        --project="${SCRIPT_DIR}/worker" -m LineCableModelsWorker "$@"
fi

if [[ "${1:-}" == "runtime" && "${2:-}" != "start" ]]; then
    exec "${JULIA_COMMAND}" --startup-file=no --threads=2 \
        --project="${SCRIPT_DIR}/runtime" -m LineCableModelsRuntime "$@"
fi

if [[ "${2:-}" != "start" || ( "${1:-}" != "playground" && "${1:-}" != "presentation" && "${1:-}" != "runtime" ) ]]; then
    exec "${JULIA_COMMAND}" --startup-file=no --threads=auto \
        --project="${SCRIPT_DIR}" -m LineCableModelsPlayground "$@"
fi

command -v setsid >/dev/null 2>&1 || die "required command not found: setsid"

control_directory="$(mktemp -d "${TMPDIR:-/tmp}/lcm-playground.XXXXXXXX")"
control_fifo="${control_directory}/shutdown"
child_pid=""
shutdown_requested=false

cleanup() {
    exec 3>&- || true
    [[ ! -p "${control_fifo}" ]] || rm -f -- "${control_fifo}"
    [[ ! -d "${control_directory}" ]] || rmdir -- "${control_directory}"
}

request_shutdown() {
    [[ "${shutdown_requested}" == false ]] || return
    shutdown_requested=true
    trap - HUP INT TERM
    printf '\nStopping LineCableModels playground...\n'
    printf '\n' >&3 || true
    if [[ -n "${child_pid}" ]]; then
        wait "${child_pid}" || true
    fi
    exit 0
}

trap cleanup EXIT
trap request_shutdown HUP INT TERM

mkfifo -- "${control_fifo}"
exec 3<>"${control_fifo}"

lcm_project="${SCRIPT_DIR}"
lcm_module="LineCableModelsPlayground"
lcm_threads="auto"
if [[ "${1:-}" == "runtime" ]]; then
    lcm_project="${SCRIPT_DIR}/runtime"
    lcm_module="LineCableModelsRuntime"
    lcm_threads="2"
fi
LCM_SUPERVISED=1 setsid "${JULIA_COMMAND}" --startup-file=no --threads="$lcm_threads" \
    --project="$lcm_project" -m "$lcm_module" "$@" \
    <"${control_fifo}" 3>&- &
child_pid=$!

set +e
wait "${child_pid}"
status=$?
set -e
exit "${status}"
