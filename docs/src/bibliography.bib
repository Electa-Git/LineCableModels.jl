@article{Ametani1980,
  title = {A {{General Formulation}} of {{Impedance}} and {{Admittance}} of {{Cables}}},
  author = {Ametani, A.},
  year = 1980,
  month = may,
  journal = {IEEE Transactions on Power Apparatus and Systems},
  volume = {PAS-99},
