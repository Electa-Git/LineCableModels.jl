  author = {De Conti, Alberto and De Lima, Antonio Carlos Siqueira},
  year = 2024,
  month = jun,
  journal = {IEEE Transactions on Electromagnetic Compatibility},
  volume = {66},
  number = {3},
  pages = {993--1000},
  issn = {0018-9375, 1558-187X},
  doi = {10.1109/TEMC.2024.3377553},
  urldate = {2026-09-04},
  abstract = {This article proposes an expression for the calculation of the ground-return impedance of underground cables based on a Pad\'e approximation of Sunde's integral equation. The accuracy of the proposed equation is demonstrated up to 10 MHz for a wide range of ground resistivities, cable separations, and burial depths. The proposed equation is more accurate than other approximate expressions available in the literature for representing Sunde's equation. It can also reproduce a more general formulation available for the calculation of the ground-return impedance of underground cables with sufficient accuracy.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  keywords = {Analytical,Closed-form,Earth impedance,Ground return,Integral form,Underground cables},
}

@article{DeConti2023a,
